      "parameters": {
        "jsCode": "// ==========================================\n// 1. MAPA DE AGENTES (ID Chatwoot -> ID GLPI)\n// ==========================================\nconst mapaAgentes = {\n  // --- \"CHATWOOT ID\" : GLPI ID ---\n  \"3110\": 2,   // WM SAÚDE\n  \"3113\": 10,  // MILENA DUTRA\n  \"3114\": 8,   // MATHEUS TAVARES\n  \"3116\": 9,   // JENIFFER VICTORIA\n  \"3117\": 11,  // DAYANNA CLAUDINO\n  \"3119\": 12,  // LUIZ FERNANDO\n  \"2348\": 14,  // ÍTALO WAGNER\n  \"3123\": 15,  // CRISTIANE CARVALHO\n  \"3124\": 16,  // MONIQUE KELLY\n  \"3125\": 17,  // GERSON JUNIOR\n  \"3129\": 18,  // RAFAEL CRUZ\n  \"3128\": 19,  // GUILHERME DA INVENÇÃO\n  \"2494\": 20,  // FELIPE JOVINO\n  \"3131\": 21,  // ADAILSON ROCHA\n  \"3132\": 22,  // EDIMILSON BASTOS\n  \"3133\": 23,  // DANIEL LOPES\n  \"3134\": 24,  // DANILO ROCHA\n  \"3135\": 25,  // JONATAS NATÃ \n  \"3136\": 26,  // JADEILSON ROCHA \n  \"3140\": 27,  // VITOR OLIVEIRA\n  \"3143\": 28,  // ISABELLA CHAVES\n  \"3144\": 29,  // DEBORAH MACHADO\n  \"3146\": 30,  // GRAZIELLY MARINHO\n  \"3147\": 31,  // ELERY MAYARA\n  \"3148\": 33,  // THAIS LADEIA\n  \"3145\": 32,  // DANIELA SOUZA\n  \"3142\": 34,  // MARIA LUISA\n  \"3141\": 35,  // ANA FLAVIA\n  \"3139\": 36,  // ANA CAMILA\n  \"3138\": 37,  // JANAÍNA LUZ\n  \"3137\": 38,  // LUIS DANIEL\n  \"1828\": 39,  // SUCESSO DO CLIENTE - GROWBIT\n  \"3130\": 40,  // GUSTAVO ALBERTO\n  \"3127\": 42,  // RAFELA\n  \"3126\": 41,  // RENATA\n  \"3122\": 43,  // NAIARA BATISTA\n  \"3121\": 44,  // LEANDRO GONÇALVES\n  \"3120\": 47,  // DANIEL DAVID\n  \"3118\": 46,  // WELLINGTON COSTA\n  \"3115\": 48,  // DAISY MEDEIROS\n  \"3150\": 50,  // GERALDO GUIMARÃES\n  \"3151\": 51,  // TAIS FERNANDES\n  \"2346\": 52   // CLAUDIO SANTOS\n};\n\n// ==========================================\n// 2. PROCESSAR O AGENTE DO WEBHOOK\n// ==========================================\nlet agente_id_glpi = 0;\nlet nome_agente = \"Não atribuído\";\n\nconst idChatwoot = $node[\"Webhook\"].json.body.meta?.assignee?.id || \n                   $node[\"Webhook\"].json.body.data?.assignee?.id;\n\nif (idChatwoot && mapaAgentes[idChatwoot.toString()]) {\n    agente_id_glpi = mapaAgentes[idChatwoot.toString()];\n    nome_agente = $node[\"Webhook\"].json.body.meta?.assignee?.name || \"Detectado\";\n}\n\n// ==========================================\n// 3. PROCESSAR A EQUIPE (GRUPO)\n// ==========================================\nlet glpi_group_id = 0;\nconst teamNameChatwoot = $node[\"Webhook\"].json.body.meta?.team?.name || \n                         $node[\"Webhook\"].json.body.team?.name;\n\nif (teamNameChatwoot) {\n    const normalizar = (t) => t.trim().toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n    const nomeNormalizadoChatwoot = normalizar(teamNameChatwoot);\n\n    const gruposGlpi = $input.all();\n    const grupoEncontrado = gruposGlpi.find(i => \n        i.json.name && normalizar(i.json.name) === nomeNormalizadoChatwoot\n    );\n    \n    if (grupoEncontrado) glpi_group_id = grupoEncontrado.json.id;\n}\n\n// ==========================================\n// 4. RETORNO FINAL\n// ==========================================\nreturn {\n    agente_id_glpi, \n    glpi_group_id,\n    id_chatwoot_detectado: idChatwoot || \"Nenhum\",\n    nome_agente_detectado: nome_agente,\n    tipo_glpi_id: 1 \n};"
      },

      "parameters": {
        "jsCode": "// ==========================================\n// 1. MAPA DE AGENTES (ID Chatwoot -> ID GLPI)\n// ==========================================\nconst mapaAgentes = {\n  // --- EQUIPA ANTIGA ---\n  \"3\": 10,  // MILENA DUTRA\n  \"4\": 8,   // MATHEUS TAVARES\n  \"5\": 9,   // JENIFFER VICTORIA\n  \"7\": 11,  // DAYANNA CLAUDINO\n  \"8\": 12,  // LUIZ FERNANDO\n  \"10\": 14, // ÍTALO WAGNER\n  \"11\": 15, // CRISTIANE CARVALHO\n  \"12\": 16, // MONIQUE KELLY\n  \"13\": 17, // GERSON JUNIOR\n  \"14\": 18, // RAFAEL CRUZ\n  \"15\": 20, // FELIPE JOVINO\n  \"16\": 19, // GUILHERME DA INVENÇÃO\n  \"17\": 21, // ADAILSON ROCHA\n  \"18\": 22, // EDIMILSON BASTOS\n  \"19\": 23, // DANIEL LOPES\n  \"20\": 24, // DANILO ROCHA\n  \"21\": 25, // JONATAS NATÃ \n  \"22\": 26, // JADEILSON ROCHA \n\n  // --- NOVA EQUIPA (Preenchidos pela ordem de exportação do CSV) ---\n  \n  // O utilizador WM Saúde é o primeiro do CSV. O GLPI costuma usar o ID 2 para o super-admin.\n  \"2\": 2,   // WM SAÚDE \n\n  \"25\": 27, // VITOR OLIVEIRA\n  \"26\": 28, // ISABELLA CHAVES\n  \"27\": 29, // DEBORAH MACHADO\n  \"28\": 30, // GRAZIELLY MARINHO\n  \"29\": 31, // ELERY MAYARA\n  \"30\": 33, // THAIS LADEIA\n  \"31\": 32, // DANIELA SOUZA\n  \"32\": 34, // MARIA LUISA (Sem e-mail no GLPI, mas vai associar pelo ID!)\n  \"33\": 35, // ANA FLAVIA\n  \"34\": 36, // ANA CAMILA\n  \"35\": 37, // JANAÍNA LUZ\n  \"36\": 38, // LUIS DANIEL\n  \"37\": 39, // SUCESSO DO CLIENTE - GROWBIT\n  \"38\": 40, // GUSTAVO ALBERTO\n\n  // A Rafaela não estava no CSV, por isso deixei com 0 para o fluxo não encravar.\n  // Quando a criar no GLPI, será provavelmente o ID 41.\n  \"39\": 0, // RAFAELA\n  \"40\": 42, // RENATA\n  \"41\": 43 // NAIARA BARISTA\n};\n\n// ==========================================\n// 2. PROCESSAR O AGENTE DO WEBHOOK\n// ==========================================\nlet agente_id_glpi = 0;\nlet nome_agente = \"Não atribuído\";\n\nconst idChatwoot = $node[\"Webhook\"].json.body.meta?.assignee?.id || \n                   $node[\"Webhook\"].json.body.data?.assignee?.id;\n\nif (idChatwoot && mapaAgentes[idChatwoot.toString()]) {\n    agente_id_glpi = mapaAgentes[idChatwoot.toString()];\n    nome_agente = $node[\"Webhook\"].json.body.meta?.assignee?.name || \"Detectado\";\n}\n\n// ==========================================\n// 3. PROCESSAR A EQUIPE (GRUPO)\n// ==========================================\nlet glpi_group_id = 0;\nconst teamNameChatwoot = $node[\"Webhook\"].json.body.meta?.team?.name || \n                         $node[\"Webhook\"].json.body.team?.name;\n\nif (teamNameChatwoot) {\n    const normalizar = (t) => t.trim().toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n    const nomeNormalizadoChatwoot = normalizar(teamNameChatwoot);\n\n    const gruposGlpi = $input.all();\n    const grupoEncontrado = gruposGlpi.find(i => \n        i.json.name && normalizar(i.json.name) === nomeNormalizadoChatwoot\n    );\n    \n    if (grupoEncontrado) glpi_group_id = grupoEncontrado.json.id;\n}\n\n// ==========================================\n// 4. RETORNO FINAL\n// ==========================================\nreturn {\n    agente_id_glpi, \n    glpi_group_id,\n    id_chatwoot_detectado: idChatwoot || \"Nenhum\",\n    nome_agente_detectado: nome_agente,\n    tipo_glpi_id: 1 \n};"
      },
